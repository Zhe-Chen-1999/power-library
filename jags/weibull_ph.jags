## Weibull proportional-hazards survival model with right censoring.
##
## Sample size N and all prior hyperparameters arrive as data, so one file
## serves every scenario -- nothing here needs editing per analysis.
##
## JAGS parameterisation: t ~ dweib(alpha, lambda) has
##     S(t) = exp(-lambda * t^alpha)
## so lambda[i] = exp(beta0 + beta.trt * trt[i]) is proportional hazards
## with log hazard ratio beta.trt. Positive beta.trt = higher hazard of the
## event in the treated arm.
##
## dinterval() handles right censoring: t[i] is NA when censored and
## is.censored[i] = 1 tells JAGS that the true t[i] exceeds t.cen[i].

model {
  for (i in 1:N) {
    is.censored[i] ~ dinterval(t[i], t.cen[i])
    t[i] ~ dweib(alpha, lambda[i])
    lambda[i] <- exp(beta0 + beta.trt * trt[i])
  }

  beta0    ~ dnorm(prior_beta0_mean, prior_beta0_prec)
  beta.trt ~ dnorm(prior_trt_mean,   prior_trt_prec)
  alpha    ~ dgamma(prior_alpha_shape, prior_alpha_rate)
}
